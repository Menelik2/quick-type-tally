# Copy this file to .env and fill in your Supabase project settings.
# VITE_ variables are bundled into the browser: never put service-role keys or
# other private server credentials in any VITE_ variable.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
